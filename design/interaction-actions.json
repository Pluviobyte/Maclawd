{
  "schemaVersion": 2,
  "priority": "interaction-overlays-current-state-briefly",
  "interactions": [
    {
      "id": "interaction.click",
      "name": "Poke Squish",
      "mode": "reaction",
      "durationMs": 2200,
      "source": "src/animations/click-flinch.svg",
      "trigger": "single click or poke"
    },
    {
      "id": "interaction.double_click",
      "name": "Surprised Hop",
      "mode": "reaction",
      "durationMs": 2400,
      "source": "src/animations/surprised-hop.svg",
      "trigger": "double or rapid click"
    },
    {
      "id": "interaction.drag",
      "name": "Hanging Loop",
      "mode": "held",
      "durationMs": 3200,
      "source": "src/animations/drag-cling.svg",
      "trigger": "pointer drag begins"
    },
    {
      "id": "interaction.drop",
      "name": "Drop Wobble",
      "mode": "reaction",
      "durationMs": 2600,
      "source": "src/animations/drop-wobble.svg",
      "trigger": "pointer drag ends"
    },
    {
      "id": "ambient.edge",
      "name": "Curtain Peek",
      "mode": "loop",
      "durationMs": 4600,
      "source": "src/animations/edge-peek.svg",
      "trigger": "pet enters configured screen-edge idle behavior"
    },
    {
      "id": "ambient.low_battery",
      "name": "Low Battery Droop",
      "mode": "loop",
      "durationMs": 6200,
      "source": "src/animations/low-battery-droop.svg",
      "trigger": "system battery crosses configured threshold",
      "accessory": "none"
    }
  ],
  "modes": {
    "loop": "自然循环播放，直到被更高优先级或新事件替换。",
    "oneshot": "插播一次，播完回到当前最高优先级的循环态。",
    "held": "条件成立期间持续显示，条件消失后回到仲裁结果。与 loop 的区别是它由外部条件而非仲裁维持——拖拽中、悬停中、贴边、低电量都属此类。",
    "reaction": "oneshot 的别名，语义上强调这是对用户输入的即时反馈。"
  }
}
